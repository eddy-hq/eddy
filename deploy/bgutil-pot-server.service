# Template: deploy/setup-ubuntu.sh fills __USER__, __HOME__ and __NODE_BIN__.
[Unit]
Description=bgutil yt-dlp PO Token provider
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
WorkingDirectory=__HOME__/bgutil-ytdlp-pot-provider/server
ExecStart=__NODE_BIN__ build/main.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bgutil-pot

[Install]
WantedBy=multi-user.target
