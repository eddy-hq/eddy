{
  "name": "eddy",
  "version": "0.1.0",
  "description": "Family media system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:pwa": "vite",
    "build": "tsc && vite build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "health": "bash scripts/healthcheck.sh",
    "worker": "tsx src/workers/download.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.0",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.12.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "framer-motion": "^12.38.0",
    "ioredis": "^5.3.2",
    "lucide-react": "^1.8.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
