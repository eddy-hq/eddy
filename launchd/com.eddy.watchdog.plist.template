<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eddy.watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__EDDY_DIR__/scripts/watchdog.sh</string>
    </array>

    <!-- Watchdog is a long-running daemon: it loops internally and sleeps
         between checks. launchd's StartInterval was coalesced unreliably
         on macOS (skipped minutes of fires), so we do our own scheduling
         and rely on KeepAlive for crash recovery only. -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__EDDY_DIR__/logs/watchdog.log</string>

    <key>StandardErrorPath</key>
    <string>__EDDY_DIR__/logs/watchdog.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
