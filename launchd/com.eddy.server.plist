<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eddy.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/steveu/.nvm/versions/node/v24.14.1/bin/node</string>
        <string>/Users/steveu/code/eddy/node_modules/.bin/tsx</string>
        <string>watch</string>
        <string>--include</string>
        <string>src/**/*.ts</string>
        <string>src/index.ts</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/steveu/code/eddy</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Force chokidar polling so tsx watch detects edits to imported
             files under launchd (FSEvents is unreliable for daemonised
             processes on macOS). -->
        <key>CHOKIDAR_USEPOLLING</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/Users/steveu/code/eddy/logs/server.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/steveu/code/eddy/logs/server.stderr.log</string>
</dict>
</plist>
