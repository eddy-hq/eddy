# Optional. Copy to release.env (gitignored) if release-adhoc.sh fails with
# "exportArchive No Accounts". Create the key at App Store Connect → Users and
# Access → Integrations → App Store Connect API, role Admin, and keep the .p8
# outside the repo.
ASC_KEY_PATH=/Users/youruser/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
