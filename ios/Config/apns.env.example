# Copy to apns.env (gitignored). APNs auth key: developer.apple.com → Certificates,
# IDs & Profiles → Keys → new key with "Apple Push Notifications service (APNs)".
# Keep the .p8 outside the repo.
APNS_KEY_PATH=/absolute/path/outside/the/repo/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
