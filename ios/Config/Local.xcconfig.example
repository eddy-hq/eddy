// Copy to Local.xcconfig (gitignored) to build for a device.
// Simulator builds do not need this file at all.

// Your Apple Developer team id — the 10-character string from
// Xcode > Settings > Accounts, or developer.apple.com > Membership.
DEVELOPMENT_TEAM = XXXXXXXXXX

// Required for a device release: the HTTPS host your Eddy server answers on.
// Shared.xcconfig only carries a placeholder. EDDY_URL_SLASH is defined there
// and exists only to smuggle the "//" past xcconfig's comment stripper.
// EDDY_BASE_URL = https:$(EDDY_URL_SLASH)$(EDDY_URL_SLASH)eddy.example.ts.net
