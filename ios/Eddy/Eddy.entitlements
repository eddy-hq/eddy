<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with EddyShare (and, later, the notification service
	     extension) so they can read the stored userId. The team prefix comes
	     from $(AppIdentifierPrefix) at build time and is never committed. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.eddyhq.Eddy.shared</string>
	</array>
</dict>
</plist>
