# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3737

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./eddy.db

# ── Redis (BullMQ) — runs natively on M4 via Homebrew ─────────────────────────
# M4 uses 127.0.0.1; Ubuntu worker uses your-worker-host (Tailscale MagicDNS).
# Password is hex (openssl rand -hex 32) to avoid URL-encoding issues.
REDIS_URL=redis://default:REPLACE_ME@your-worker-host:6379

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_GUARD_MODEL=gemma4:e4b
# Optional — model for the Tier 4 week-summary line (issue #143). Unset reuses
# OLLAMA_GUARD_MODEL.
# OLLAMA_SUMMARY_MODEL=gemma4:e4b

# ── Users ──────────────────────────────────────────────────────────────────────
USER_NAME_STEVE=FirstName
USER_NAME_BOY1=FirstName
USER_NAME_BOY2=FirstName
USER_NAME_PARTNER=FirstName
# Fixed UUIDs — used in Shortcuts and DB seed. Do not change after first run.
USER_ID_STEVE=generate-with-uuid-v7
USER_ID_BOY1=generate-with-uuid-v7
USER_ID_BOY2=generate-with-uuid-v7
# Optional. Used to derive guard prompt age bands; unset falls back to the most restrictive band.
# USER_BIRTH_YEAR_BOY1=2012
# USER_BIRTH_YEAR_BOY2=2016

# ── Security ───────────────────────────────────────────────────────────────────
# Min 32 chars. Used for HMAC-SHA256 signing of notification action tokens.
TOKEN_SECRET=change-me-to-a-long-random-secret-value
# Min 32 chars. Shared between M4 and Ubuntu worker for internal callback auth.
INTERNAL_HMAC_SECRET=change-me-to-a-long-random-secret-value

# ── Tailscale / network ────────────────────────────────────────────────────────
TAILSCALE_HOSTNAME=your-worker-host
TAILSCALE_IP=100.x.x.x

# ── Backup ─────────────────────────────────────────────────────────────────────
BACKUP_SSH_USER=youruser
BACKUP_SSH_HOST=100.x.x.x
BACKUP_DEST_PATH=/home/youruser/eddy-backups

# ── ntfy (Phase 1) ─────────────────────────────────────────────────────────────
# Per-user ntfy topic + credentials. Flattened into config.ntfyUserConfig at
# startup and injected into the notifications module — only users with both
# topic and credentials set receive notifications. Missing entries are skipped
# with a "ntfy not configured for recipient" warning.
NTFY_BASE_URL=https://mediaserver.your-tailnet.ts.net
NTFY_TOPIC_STEVE=eddy-steve-changeme
NTFY_TOPIC_BOY1=eddy-boy1-changeme
NTFY_TOPIC_BOY2=eddy-boy2-changeme
NTFY_CREDS_STEVE=user:changeme
NTFY_CREDS_BOY1=boy1:changeme
NTFY_CREDS_BOY2=boy2:changeme

# ── Video storage ──────────────────────────────────────────────────────────────
# Local path on Ubuntu where the worker writes videos (served by nginx + Plex)
# Full path required — pip installs yt-dlp to ~/.local/bin which systemd won't find
YTDLP_BIN=/home/youruser/.local/bin/yt-dlp
# yt-dlp path on the M4 (anonymous channel search + metadata). Prefer a
# standalone nightly build at ~/.local/bin/yt-dlp so it tracks the same channel
# as the Ubuntu worker (self-update: `yt-dlp --update-to nightly`). Homebrew
# stable (shown) is the config default and an acceptable fallback, but its build
# blocks self-update so it can't follow nightly.
YTDLP_BIN_M4=/opt/homebrew/bin/yt-dlp
# Full path to node binary — nvm installs to ~/.nvm which systemd won't find
NODE_BIN=/home/youruser/.nvm/versions/node/v24.14.1/bin/node
VIDEO_OUTPUT_PATH=/home/youruser/eddy/videos
# nginx on Ubuntu serving the video directory
NGINX_VIDEO_BASE_URL=http://100.x.x.x/videos
# Thumbnail output path on Ubuntu (kept forever — cheap storage, needed for recycled-card restore)
THUMB_OUTPUT_PATH=/mnt/ssd/eddy/thumbs
# nginx on Ubuntu serving the thumbs directory
NGINX_THUMB_BASE_URL=http://100.x.x.x/thumbs
# Public HTTPS replacements for the two NGINX_*_BASE_URL values above. The
# API rewrites persisted http://<mediaserver>/... URLs to these on the way
# out so the PWA stays same-origin under HTTPS (no mixed-content blocking).
# Leave unset in dev to keep raw nginx URLs.
PUBLIC_VIDEO_BASE_URL=https://eddyhq.app/videos
PUBLIC_THUMB_BASE_URL=https://eddyhq.app/thumbs
# Optional: path to a Netscape-format cookies.txt for age-restricted or auth-gated videos
# Export from browser with a cookies.txt extension, e.g. /home/youruser/eddy/youtube-cookies.txt
# YTDLP_COOKIES_FILE=/home/youruser/eddy/youtube-cookies.txt

# ── Worker → M4 callback ───────────────────────────────────────────────────────
# Set this on the Ubuntu worker only. M4's Tailscale address + port.
M4_INTERNAL_URL=http://100.x.x.x:3737

# ── Plex (Phase 1) ─────────────────────────────────────────────────────────────
PLEX_URL=http://100.x.x.x:32400
PLEX_TOKEN=changeme
PLEX_LIBRARY_SECTION_ID=3

# ── Storage recycling (issue #115) ────────────────────────────────────────────
# Per-user soft budget and global hard cap, in bytes. The nightly recycler
# frees files for users over budget in priority order (dismissed → watched →
# unwatched-skip-48h; saved videos are never recycled). After per-user passes,
# any remaining global over-cap pulls further victims across all users.
# Defaults: 100 GiB per user, 350 GiB total.
USER_STORAGE_QUOTA_BYTES=107374182400
GLOBAL_STORAGE_CAP_BYTES=375809638400

# ── Discovery intake (issue #147) ─────────────────────────────────────────────
# Channel-level dismissal filter. Interest-search results from a channel the
# user has rejected this many times are skipped before scoring. Counts come
# from candidate_pool.status='dismissed' (pre-play swipe) and
# requests.status='deleted' (player delete), aggregated per channel name.
# Set to 0 to disable the filter entirely. Default: 3.
DISCOVERY_CHANNEL_DISMISS_THRESHOLD=3

# ── Discovery slate size (ADR-0009) ───────────────────────────────────────────
# Role-blind default for the per-user `daily_pick_cap` column. The daily slate
# is one scored pool composed into reserved slots up to this ceiling:
# subscription = cap − 6, back-catalogue 4, delighter 2. The numbers are
# role-blind — the only kid/adult difference is the guard recheck. A user whose
# column is null falls back to this default at compose time.
DEFAULT_DAILY_PICK_CAP=15

# ── yt-dlp throttling (issue #185) ────────────────────────────────────────────
# Defend the shared residential IP from YouTube's volume-triggered bot-detection
# ("Sign in to confirm you're not a bot"). See docs/ops.md "yt-dlp version
# channel & the PO-token stack".
# Cooldown after a detected block: the download worker parks queued jobs in
# BullMQ's delayed state and discovery skips its searches for this many seconds
# instead of retrying into a blocked IP. Shared cross-process via Redis. Default
# 2700 = 45 min. Set 0 to disable the gate.
YTDLP_BOTDETECT_COOLDOWN_SECS=2700
# Interest-search depth (the N in ytsearchN). Was hardcoded 20; halved to cut
# per-run extraction volume.
DISCOVERY_SEARCH_LIMIT=10
# Base + random jitter (ms) between consecutive discovery searches so the
# per-user fan-out drips rather than bursts. Effective gap = base + rand(0,jit).
# Set base 0 to disable inter-search spacing.
DISCOVERY_SEARCH_DELAY_MS=2000
DISCOVERY_SEARCH_JITTER_MS=2000
# Per-user discovery hour (local time, 0–23). Each user's daily slate composes
# at their own hour so the fleet's search + download volume spreads across the
# day instead of one 06:00 spike from the shared residential IP. The channel-wide
# RSS poll runs once at the earliest of these hours, ahead of any user. Boys are
# mid-morning / early-afternoon so their slate is fresh before after-school.
DISCOVERY_HOUR_STEVE=6
DISCOVERY_HOUR_BOY2=10
DISCOVERY_HOUR_BOY1=14
# Fallback hour for any eligible (kid/parent) user not named above.
DISCOVERY_HOUR_DEFAULT=6
# Freshness TTL (days) for the per-person channel-info refresh (bio + avatar).
# The RSS poll fires this once per followed channel each pass; bio/avatar are
# near-static, so the yt-dlp channel-page fetch is skipped unless the last
# successful refresh is older than this — the dominant volume cut on the people
# path. Deliberately long. Set 0 to disable (refetch every pass).
PERSON_CHANNEL_INFO_TTL_DAYS=30
# Global daily download budget (ADR-0012). Caps AUTOMATED downloads — slate-
# selected delighters plus follow-sourced subscription / back-catalogue picks —
# across all users for one UTC day. Slate-bound picks are funded first, follows
# second; once spent, remaining automated candidates wait and stay selectable on
# a later day (no failure). Explicit share-sheet / on-demand requests count
# toward the tally but are never refused. Set 0 to block all automated downloads.
DOWNLOAD_DAILY_BUDGET=10
# Back-catalogue moratorium (ADR-0012). true (default) mines followed channels'
# back catalogues into the slate; false halts it (new-upload subscriptions and
# interest search still run). Only 'true' or 'false'.
BACK_CATALOGUE_ENABLED=true
# ── Discovery metadata source (#189) ──────────────────────────────────────────
# Where discovery reads metadata from. 'ytdlp' (default) scrapes via yt-dlp on
# the M4; 'api' uses the YouTube Data API v3 to cut the ~450 hits/day that trip
# YouTube's IP-wide bot-detection. Downloads stay on yt-dlp either way.
DISCOVERY_SOURCE=ytdlp
# YouTube Data API v3 key — required only when DISCOVERY_SOURCE=api. A plain API
# key (public read-only data, no OAuth) from a Google Cloud project with the
# YouTube Data API enabled. Restrict the key to that API. Free 10k units/day.
# YOUTUBE_API_KEY=
