# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3737

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./eddy.db

# ── Redis (BullMQ) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_GUARD_MODEL=gemma4:e4b

# ── Users ──────────────────────────────────────────────────────────────────────
USER_NAME_STEVE=Steve
USER_NAME_SON1=FirstName
USER_NAME_SON2=FirstName
USER_NAME_PARTNER=FirstName
# Fixed UUIDs — used in Shortcuts and DB seed. Do not change after first run.
USER_ID_STEVE=generate-with-uuid-v7
USER_ID_SON1=generate-with-uuid-v7
USER_ID_SON2=generate-with-uuid-v7

# ── Security ───────────────────────────────────────────────────────────────────
# Min 32 chars. Used for HMAC-SHA256 signing of notification action tokens.
TOKEN_SECRET=change-me-to-a-long-random-secret-value

# ── Tailscale / network ────────────────────────────────────────────────────────
# Used for building signed action URLs in notifications
TAILSCALE_HOSTNAME=mini-steve
TAILSCALE_IP=100.101.51.114

# ── Backup ─────────────────────────────────────────────────────────────────────
BACKUP_SSH_USER=steveu
BACKUP_SSH_HOST=100.95.170.27
BACKUP_DEST_PATH=/home/steveu/eddy-backups

# ── ntfy (Phase 1) ─────────────────────────────────────────────────────────────
# Self-hosted ntfy on Ubuntu, accessible over Tailscale
NTFY_BASE_URL=http://100.95.170.27:2586
NTFY_TOPIC_STEVE=eddy-steve-changeme
NTFY_TOPIC_SON1=eddy-son1-changeme
NTFY_TOPIC_SON2=eddy-son2-changeme
# Per-user basic auth credentials (user:password)
NTFY_CREDS_STEVE=steve:changeme
NTFY_CREDS_SON1=son1:changeme
NTFY_CREDS_SON2=son2:changeme

# ── Video storage (Phase 1) ────────────────────────────────────────────────────
# SSH details for rsync transfer from M4 to Ubuntu after download
VIDEO_SSH_USER=steveu
VIDEO_SSH_HOST=100.95.170.27
VIDEO_SSH_KEY=~/.ssh/id_ed25519_eddy
# Path on Ubuntu where videos are stored (served by nginx)
VIDEO_REMOTE_PATH=/home/steveu/eddy/videos
# Local temp dir on M4 for yt-dlp downloads before transfer
VIDEO_TEMP_PATH=/tmp/eddy-downloads
# nginx on Ubuntu serving the video directory
NGINX_VIDEO_BASE_URL=http://100.95.170.27/videos

# ── Plex (Phase 1) ─────────────────────────────────────────────────────────────
PLEX_URL=http://100.95.170.27:32400
PLEX_TOKEN=changeme
PLEX_LIBRARY_SECTION_ID=3
