# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3737

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./eddy.db

# ── Redis (BullMQ) — runs natively on M4 via Homebrew ─────────────────────────
# M4 uses 127.0.0.1; Ubuntu worker uses your-worker-host (Tailscale MagicDNS).
# Password is hex (openssl rand -hex 32) to avoid URL-encoding issues.
REDIS_URL=redis://default:REPLACE_ME@your-worker-host:6379

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_GUARD_MODEL=gemma4:e4b

# ── Users ──────────────────────────────────────────────────────────────────────
USER_NAME_STEVE=FirstName
USER_NAME_BOY1=FirstName
USER_NAME_BOY2=FirstName
USER_NAME_PARTNER=FirstName
# Fixed UUIDs — used in Shortcuts and DB seed. Do not change after first run.
USER_ID_STEVE=generate-with-uuid-v7
USER_ID_BOY1=generate-with-uuid-v7
USER_ID_BOY2=generate-with-uuid-v7
# Optional. Used to derive guard prompt age bands; unset falls back to the most restrictive band.
# USER_BIRTH_YEAR_BOY1=2012
# USER_BIRTH_YEAR_BOY2=2016

# ── Security ───────────────────────────────────────────────────────────────────
# Min 32 chars. Used for HMAC-SHA256 signing of notification action tokens.
TOKEN_SECRET=change-me-to-a-long-random-secret-value
# Min 32 chars. Shared between M4 and Ubuntu worker for internal callback auth.
INTERNAL_HMAC_SECRET=change-me-to-a-long-random-secret-value

# ── Tailscale / network ────────────────────────────────────────────────────────
TAILSCALE_HOSTNAME=your-worker-host
TAILSCALE_IP=100.x.x.x

# ── Backup ─────────────────────────────────────────────────────────────────────
BACKUP_SSH_USER=youruser
BACKUP_SSH_HOST=100.x.x.x
BACKUP_DEST_PATH=/home/youruser/eddy-backups

# ── ntfy (Phase 1) ─────────────────────────────────────────────────────────────
# Per-user ntfy topic + credentials. Flattened into config.ntfyUserConfig at
# startup and injected into the notifications module — only users with both
# topic and credentials set receive notifications. Missing entries are skipped
# with a "ntfy not configured for recipient" warning.
NTFY_BASE_URL=https://mediaserver.your-tailnet.ts.net
NTFY_TOPIC_STEVE=eddy-steve-changeme
NTFY_TOPIC_BOY1=eddy-boy1-changeme
NTFY_TOPIC_BOY2=eddy-boy2-changeme
NTFY_CREDS_STEVE=user:changeme
NTFY_CREDS_BOY1=boy1:changeme
NTFY_CREDS_BOY2=boy2:changeme

# ── Video storage ──────────────────────────────────────────────────────────────
# Local path on Ubuntu where the worker writes videos (served by nginx + Plex)
# Full path required — pip installs yt-dlp to ~/.local/bin which systemd won't find
YTDLP_BIN=/home/youruser/.local/bin/yt-dlp
# yt-dlp path on the M4 (used for channel search). Homebrew default shown.
YTDLP_BIN_M4=/opt/homebrew/bin/yt-dlp
# Full path to node binary — nvm installs to ~/.nvm which systemd won't find
NODE_BIN=/home/youruser/.nvm/versions/node/v24.14.1/bin/node
VIDEO_OUTPUT_PATH=/home/youruser/eddy/videos
# nginx on Ubuntu serving the video directory
NGINX_VIDEO_BASE_URL=http://100.x.x.x/videos
# Thumbnail output path on Ubuntu (kept forever — cheap storage, needed for recycled-card restore)
THUMB_OUTPUT_PATH=/mnt/ssd/eddy/thumbs
# nginx on Ubuntu serving the thumbs directory
NGINX_THUMB_BASE_URL=http://100.x.x.x/thumbs
# Public HTTPS replacements for the two NGINX_*_BASE_URL values above. The
# API rewrites persisted http://<mediaserver>/... URLs to these on the way
# out so the PWA stays same-origin under HTTPS (no mixed-content blocking).
# Leave unset in dev to keep raw nginx URLs.
PUBLIC_VIDEO_BASE_URL=https://eddyhq.app/videos
PUBLIC_THUMB_BASE_URL=https://eddyhq.app/thumbs
# Optional: path to a Netscape-format cookies.txt for age-restricted or auth-gated videos
# Export from browser with a cookies.txt extension, e.g. /home/youruser/eddy/youtube-cookies.txt
# YTDLP_COOKIES_FILE=/home/youruser/eddy/youtube-cookies.txt

# ── Worker → M4 callback ───────────────────────────────────────────────────────
# Set this on the Ubuntu worker only. M4's Tailscale address + port.
M4_INTERNAL_URL=http://100.x.x.x:3737

# ── Plex (Phase 1) ─────────────────────────────────────────────────────────────
PLEX_URL=http://100.x.x.x:32400
PLEX_TOKEN=changeme
PLEX_LIBRARY_SECTION_ID=3

# ── Storage recycling (issue #115) ────────────────────────────────────────────
# Per-user soft budget and global hard cap, in bytes. The nightly recycler
# frees files for users over budget in priority order (dismissed → watched →
# unwatched-skip-48h; saved videos are never recycled). After per-user passes,
# any remaining global over-cap pulls further victims across all users.
# Defaults: 100 GiB per user, 350 GiB total.
USER_STORAGE_QUOTA_BYTES=107374182400
GLOBAL_STORAGE_CAP_BYTES=375809638400

# ── Discovery intake (issue #147) ─────────────────────────────────────────────
# Channel-level dismissal filter. Interest-search results from a channel the
# user has rejected this many times are skipped before scoring. Counts come
# from candidate_pool.status='dismissed' (pre-play swipe) and
# requests.status='deleted' (player delete), aggregated per channel name.
# Set to 0 to disable the filter entirely. Default: 3.
DISCOVERY_CHANNEL_DISMISS_THRESHOLD=3

# ── Discovery intake — person-sourced primary (issue #149) ────────────────────
# Brief §17: person-sourced material is the primary discovery signal; interest
# search is the gap-filler that only runs when person-sourced candidates are
# thin. Counted sources for the gating decision are:
#   - candidate_pool rows with source_type in ('person_backcatalog',
#     'person_recommendation') still alive for this refresh (i.e. not
#     dismissed or guard_rejected)
#   - requests rows with source='channel_subscription' created in the last 24h
#     (RSS-poller landings from followed people)
# If the count meets or exceeds the threshold for the user's role, the interest
# search yt-dlp queries are skipped entirely. If it's below, the search runs
# with a proportionally reduced query budget. Defaults match the daily slate
# caps (adult 15 / kid 5). Set to 0 to disable gating (always full run).
DISCOVERY_PERSON_SOURCED_THRESHOLD_ADULT=15
DISCOVERY_PERSON_SOURCED_THRESHOLD_KID=5
