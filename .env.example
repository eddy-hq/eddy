# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./eddy.db

# ── Redis (BullMQ) ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Ollama ─────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_GUARD_MODEL=gemma4:e4b

# ── Security ───────────────────────────────────────────────────────────────────
# Min 32 chars. Used for HMAC-SHA256 signing of notification action tokens.
TOKEN_SECRET=change-me-to-a-long-random-secret-value

# ── Tailscale / network ────────────────────────────────────────────────────────
# Used for building signed action URLs in notifications
TAILSCALE_HOSTNAME=mini-steve
TAILSCALE_IP=100.101.51.114

# ── Backup ─────────────────────────────────────────────────────────────────────
BACKUP_SSH_USER=steveu
BACKUP_SSH_HOST=100.95.170.27
BACKUP_DEST_PATH=/home/steveu/eddy-backups

# ── ntfy (Phase 1) ─────────────────────────────────────────────────────────────
# Self-hosted ntfy on Ubuntu, accessible over Tailscale
NTFY_BASE_URL=http://100.95.170.27:2586
NTFY_TOPIC_STEVE=eddy-steve-changeme
NTFY_TOPIC_SON1=eddy-son1-changeme
NTFY_TOPIC_SON2=eddy-son2-changeme
# Per-user basic auth credentials (user:password)
NTFY_CREDS_STEVE=steve:changeme
NTFY_CREDS_SON1=son1:changeme
NTFY_CREDS_SON2=son2:changeme

# ── Video storage (Phase 1) ────────────────────────────────────────────────────
# Path on Ubuntu SSD where yt-dlp writes videos (mounted from M4 or SSH)
VIDEO_OUTPUT_PATH=/mnt/ssd/eddy/videos
# nginx on Ubuntu serving that directory
NGINX_VIDEO_BASE_URL=http://100.95.170.27/videos

# ── Plex (Phase 1) ─────────────────────────────────────────────────────────────
PLEX_URL=http://100.95.170.27:32400
PLEX_TOKEN=changeme
PLEX_LIBRARY_SECTION_ID=changeme
